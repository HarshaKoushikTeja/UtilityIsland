<Window x:Class="DynamicIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        Width="780" Height="600"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Lead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,18"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="20,2,0,12"/>
        </Style>
        <Style x:Key="TestBtn" TargetType="Button">
            <Setter Property="Width" Value="158"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <Border Background="#FF121214">
            <DockPanel Margin="14,22,14,16" LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Dynamic Island" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="14,0,0,0"/>
                    <TextBlock x:Name="VersionText" Foreground="#88FFFFFF" FontSize="11.5" Margin="14,2,0,18"/>

                    <Button x:Name="NavPet" Style="{StaticResource NavBtn}" Content="Pet" Tag="Pet" Click="Nav_Click"/>
                    <Button x:Name="NavLook" Style="{StaticResource NavBtn}" Content="Appearance" Tag="Look" Click="Nav_Click"/>
                    <Button x:Name="NavIsland" Style="{StaticResource NavBtn}" Content="Features" Tag="Island" Click="Nav_Click"/>
                    <Button x:Name="NavTest" Style="{StaticResource NavBtn}" Content="Try it out" Tag="Test" Click="Nav_Click"/>
                    <Button x:Name="NavAbout" Style="{StaticResource NavBtn}" Content="Help and privacy" Tag="About" Click="Nav_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="Closing this window keeps the island running." Foreground="#88FFFFFF" FontSize="11"
                               TextWrapping="Wrap" Margin="14,0,8,10"/>
                    <Button Style="{StaticResource NavBtn}" Content="Quit Dynamic Island" Background="#33FF453A"
                            Click="Quit_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30,26,30,22">

            <!-- PET -->
            <StackPanel x:Name="PagePet">
                <TextBlock Text="Your pet" Style="{StaticResource Heading}"/>
                <TextBlock Style="{StaticResource Lead}"
                           Text="Pick a companion to live inside the island. Click it to pet it; feed it and play with it from the island's first tab."/>

                <StackPanel x:Name="PetChoices" Orientation="Horizontal"/>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <TextBlock Text="Name" VerticalAlignment="Center" Width="60"/>
                    <TextBox x:Name="PetNameBox" Width="220" MaxLength="16" Padding="6,4" TextChanged="Name_Changed"/>
                </StackPanel>

                <CheckBox x:Name="PetEnabledBox" Content="Show the pet" Margin="0,18,0,0"
                          Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
            </StackPanel>

            <!-- APPEARANCE -->
            <ScrollViewer x:Name="PageLook" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource Heading}"/>
                    <TextBlock Style="{StaticResource Lead}"
                               Text="Drag the island to move it anywhere. Drop it near the top centre to snap it back. Changes apply straight away."/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Display" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="0,0,0,12">
                            <ComboBox x:Name="DisplayBox" Width="300" HorizontalAlignment="Left"
                                      SelectionChanged="Choice_Changed"/>
                            <TextBlock x:Name="PlacementText" FontSize="12" Foreground="#777777" TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Position" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock x:Name="PositionText" VerticalAlignment="Center" Width="170" Foreground="#444444"/>
                            <Button Content="Back to top centre" Padding="12,5" Click="ResetPosition_Click"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="Size" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <Slider x:Name="SizeSlider" Width="240" Minimum="70" Maximum="150" TickFrequency="10"
                                    IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SizeText" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Text="Idle width" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <Slider x:Name="WidthSlider" Width="240" Minimum="80" Maximum="260" TickFrequency="10"
                                    IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" VerticalAlignment="Center"/>
                            <TextBlock x:Name="WidthText" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Text="Shape" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ShapeBox" Grid.Row="4" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                  Margin="0,0,0,12" SelectionChanged="Choice_Changed">
                            <ComboBoxItem Content="Pill (like iPhone)" Tag="Pill"/>
                            <ComboBoxItem Content="Rounded rectangle" Tag="Rounded"/>
                            <ComboBoxItem Content="Square corners" Tag="Square"/>
                        </ComboBox>

                        <TextBlock Grid.Row="5" Text="Colour" VerticalAlignment="Center"/>
                        <ComboBox x:Name="BackgroundBox" Grid.Row="5" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                  Margin="0,0,0,12" SelectionChanged="Choice_Changed">
                            <ComboBoxItem Content="Black" Tag="Black"/>
                            <ComboBoxItem Content="Graphite" Tag="Graphite"/>
                            <ComboBoxItem Content="Midnight blue" Tag="Midnight"/>
                            <ComboBoxItem Content="Glass (see-through)" Tag="Glass"/>
                        </ComboBox>

                        <TextBlock Grid.Row="6" Text="Accent" VerticalAlignment="Center"/>
                        <ComboBox x:Name="AccentBox" Grid.Row="6" Grid.Column="1" Width="200" HorizontalAlignment="Left"
                                  Margin="0,0,0,12" SelectionChanged="Choice_Changed">
                            <ComboBoxItem Content="Pink" Tag="Pink"/>
                            <ComboBoxItem Content="Blue" Tag="Blue"/>
                            <ComboBoxItem Content="Green" Tag="Green"/>
                            <ComboBoxItem Content="Orange" Tag="Orange"/>
                            <ComboBoxItem Content="Purple" Tag="Purple"/>
                            <ComboBoxItem Content="Match album art" Tag="Album"/>
                        </ComboBox>
                    </Grid>

                    <CheckBox x:Name="LockBox" Content="Lock position (stop the island from being dragged)" Margin="0,6,0,0"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>

                    <Button Content="Reset appearance" HorizontalAlignment="Left" Padding="14,6" Margin="0,20,0,0"
                            Click="ResetLook_Click"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ISLAND -->
            <ScrollViewer x:Name="PageIsland" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Features" Style="{StaticResource Heading}"/>
                    <TextBlock Style="{StaticResource Lead}" Text="Changes apply straight away."/>

                    <CheckBox x:Name="HoverBox" Content="Open the island when the mouse rests on it"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Off: click to open, like tapping on iPhone."/>

                    <CheckBox x:Name="ShelfTabBox" Content="File shelf tab" Margin="0,0,0,8"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    <CheckBox x:Name="StatsTabBox" Content="System stats tab" Margin="0,0,0,14"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>

                    <CheckBox x:Name="VisualizerBox" Content="Audio visualizer"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Bars move with whatever the PC is playing. Sound is analysed in memory and never saved."/>

                    <CheckBox x:Name="VolumeBox" Content="Show volume changes on the island"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    <TextBlock Style="{StaticResource Hint}" Text="You can also scroll the mouse wheel over the island to change the volume."/>

                    <CheckBox x:Name="CallBox" Content="Call and meeting controls"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Appears when any app is using the microphone or camera. The island only checks whether they are in use; it never listens or records."/>

                    <CheckBox x:Name="ClipboardBox" Content="Clipboard history"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Keeps the last 25 things you copy, in memory only. Turning this off clears the list."/>

                    <CheckBox x:Name="CaptureBox" Content="Hide the island from screen sharing and recordings"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Useful in meetings: clipboard entries and file names on the island stay off other people's screens."/>

                    <CheckBox x:Name="FullscreenBox" Content="Get out of the way of fullscreen apps"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Moves to another display while a game or video is fullscreen, or pauses if there is only one display."/>

                    <CheckBox x:Name="StartupBox" Content="Start with Windows"
                              Checked="Toggle_Changed" Unchecked="Toggle_Changed"/>
                </StackPanel>
            </ScrollViewer>

            <!-- TRY IT OUT -->
            <StackPanel x:Name="PageTest" Visibility="Collapsed">
                <TextBlock Text="Try it out" Style="{StaticResource Heading}"/>
                <TextBlock Style="{StaticResource Lead}"
                           Text="Each button makes the island show one of its states, so you can see everything without waiting for the real event. Watch the top of your screen."/>

                <TextBlock Text="Alerts" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <WrapPanel>
                    <Button Style="{StaticResource TestBtn}" Content="Charging" Tag="charging" Click="Test_Click"/>
                    <Button Style="{StaticResource TestBtn}" Content="Low battery" Tag="lowbattery" Click="Test_Click"/>
                    <Button Style="{StaticResource TestBtn}" Content="Bluetooth device" Tag="bluetooth" Click="Test_Click"/>
                    <Button Style="{StaticResource TestBtn}" Content="Volume" Tag="volume" Click="Test_Click"/>
                    <Button Style="{StaticResource TestBtn}" Content="Lock and unlock" Tag="unlock" Click="Test_Click"/>
                </WrapPanel>

                <TextBlock Text="Live activities" FontWeight="SemiBold" Margin="0,12,0,8"/>
                <WrapPanel>
                    <Button Style="{StaticResource TestBtn}" Content="Music (15 seconds)" Tag="music" Click="Test_Click"/>
                    <Button Style="{StaticResource TestBtn}" Content="Call (12 seconds)" Tag="call" Click="Test_Click"/>
                    <Button Style="{StaticResource TestBtn}" Content="Timer (10 seconds)" Tag="timer" Click="Test_Click"/>
                </WrapPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                           Text="Start two of these together to see the second one appear as a separate bubble."/>

                <TextBlock Text="Expanded view" FontWeight="SemiBold" Margin="0,4,0,8"/>
                <WrapPanel>
                    <Button Style="{StaticResource TestBtn}" Content="Open the island" Tag="open" Click="Test_Click"/>
                </WrapPanel>
            </StackPanel>

            <!-- HELP AND PRIVACY -->
            <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                <TextBlock Text="Help and privacy" Style="{StaticResource Heading}"/>
                <TextBlock Style="{StaticResource Lead}" Text="How to use the island, and what it does with your data."/>

                <TextBlock Text="Using it" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" LineHeight="21" Foreground="#333333">
                    Click the island to open it; move the mouse away to close it.<LineBreak/>
                    Drag the island to move it; drop it near the top centre to snap it back.<LineBreak/>
                    Scroll over the island to change the volume.<LineBreak/>
                    Drag files onto the island to park them on the shelf, then drag them back out.<LineBreak/>
                    Click the pet to pet it.<LineBreak/>
                    This window is always available from the island's icon near the clock.
                </TextBlock>

                <TextBlock Text="Privacy" FontWeight="SemiBold" Margin="0,18,0,6"/>
                <TextBlock TextWrapping="Wrap" LineHeight="21" Foreground="#333333">
                    Nothing leaves this PC: the app makes no network connections.<LineBreak/>
                    Clipboard history and audio analysis live in memory only and are gone when you quit.<LineBreak/>
                    Settings, shelf file paths and your pet are saved in one small file on this PC.
                </TextBlock>

                <Button Content="Open the data folder" HorizontalAlignment="Left" Padding="14,7" Margin="0,18,0,0"
                        Click="DataFolder_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
