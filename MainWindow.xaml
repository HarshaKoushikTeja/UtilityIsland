<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pets="clr-namespace:DynamicIsland.Pets"
        Title="Dynamic Island"
        Width="680" Height="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="False">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Round icon button -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small text pill button -->
        <Style x:Key="TextBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="13"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Volume slider: thin track, white fill, round thumb -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="White" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderRest" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IslandSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="LargeChange" Value="10"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRest}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Full-width row used for clipboard entries -->
        <Style x:Key="RowBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="10,7">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       TextTrimming="CharacterEllipsis" Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">

        <!-- Second activity, shown as a separate bubble like on iPhone -->
        <Border x:Name="Bubble" Width="34" Height="34" CornerRadius="17" Background="Black"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="BubbleShift" X="98"/>
            </Border.RenderTransform>
            <TextBlock x:Name="BubbleGlyph" FontFamily="{StaticResource Icons}" FontSize="13"
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- The island -->
        <Grid x:Name="Pill" Width="150" Height="34"
              HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
              RenderTransformOrigin="0.5,0" AllowDrop="True"
              MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave"
              MouseLeftButtonUp="Pill_MouseLeftButtonUp" MouseWheel="Pill_MouseWheel"
              DragEnter="Pill_DragEnter" DragOver="Pill_DragOver"
              DragLeave="Pill_DragLeave" Drop="Pill_Drop">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>

            <Rectangle x:Name="PillBg" Fill="Black" RadiusX="17" RadiusY="17">
                <Rectangle.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.35"/>
                </Rectangle.Effect>
            </Rectangle>

            <Grid x:Name="PillContent">

                <!-- Compact: icon / art on the left, live info on the right -->
                <Grid x:Name="CompactView" Margin="8,0,11,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="ArtSmall" Width="22" Height="22" CornerRadius="6"
                                Background="#33FFFFFF" Visibility="Collapsed"/>
                        <TextBlock x:Name="LeadGlyph" FontFamily="{StaticResource Icons}" FontSize="14"
                                   Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock x:Name="LeadText" FontSize="12.5" FontWeight="SemiBold" Foreground="White"
                                   Margin="8,0,0,0" MaxWidth="120" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- The pet roams the free space in the middle of the pill -->
                    <Grid x:Name="PetHost" Grid.Column="1" Height="24" Margin="4,0" VerticalAlignment="Center">
                        <pets:PetControl x:Name="Pet" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="BarsHost" Orientation="Horizontal" Height="18" Visibility="Collapsed"/>
                        <TextBlock x:Name="TrailText" FontSize="12.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Expanded: tabs + panels -->
                <Grid x:Name="ExpandedView" Width="420" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                    <StackPanel Margin="18,12,18,16">

                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="TabHome" Style="{StaticResource IconBtn}" Content="&#xE80F;"
                                        Tag="Home" Click="Tab_Click" ToolTip="Now"/>
                                <Button x:Name="TabAudio" Style="{StaticResource IconBtn}" Content="&#xE767;"
                                        Tag="Audio" Click="Tab_Click" ToolTip="Volume"/>
                                <Button x:Name="TabShelf" Style="{StaticResource IconBtn}" Content="&#xE8B7;"
                                        Tag="Shelf" Click="Tab_Click" ToolTip="File shelf"/>
                                <Button x:Name="TabClip" Style="{StaticResource IconBtn}" Content="&#xE77F;"
                                        Tag="Clip" Click="Tab_Click" ToolTip="Clipboard history"/>
                                <Button x:Name="TabStats" Style="{StaticResource IconBtn}" Content="&#xE9D9;"
                                        Tag="Stats" Click="Tab_Click" ToolTip="System stats"/>
                            </StackPanel>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE713;" HorizontalAlignment="Right"
                                    Background="Transparent" Click="Settings_Click" ToolTip="Control panel"/>
                        </Grid>

                        <!-- HOME -->
                        <StackPanel x:Name="HomePanel">

                            <!-- Call / meeting controls -->
                            <Grid x:Name="CallSection" Visibility="Collapsed" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="CallApp" FontSize="15" FontWeight="SemiBold" Foreground="White"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="CallInfo" FontSize="12" Foreground="#FF30D158" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="MicBtn" Style="{StaticResource IconBtn}" Content="&#xE720;"
                                            Click="MicBtn_Click" ToolTip="Mute or unmute your microphone"/>
                                    <Button x:Name="SpeakerBtn" Style="{StaticResource IconBtn}" Content="&#xE767;"
                                            Click="SpeakerBtn_Click" ToolTip="Mute or unmute sound"/>
                                    <Button x:Name="ShowAppBtn" Style="{StaticResource IconBtn}" Content="&#xE8A7;"
                                            Click="ShowAppBtn_Click" ToolTip="Bring the call window to the front"/>
                                </StackPanel>
                            </Grid>

                            <!-- Now playing -->
                            <Grid x:Name="MediaSection" Visibility="Collapsed" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border x:Name="ArtBig" Width="56" Height="56" CornerRadius="12" Background="#33FFFFFF"/>
                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="MediaTitle" FontSize="14" FontWeight="SemiBold" Foreground="White"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="MediaArtist" FontSize="12" Foreground="#99FFFFFF" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel x:Name="BigBars" Grid.Column="2" Orientation="Horizontal" Height="32"
                                            VerticalAlignment="Center"/>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal"
                                            HorizontalAlignment="Center" Margin="0,12,0,0">
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE892;" Background="Transparent"
                                            Click="Prev_Click" ToolTip="Previous"/>
                                    <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Content="&#xE768;"
                                            Width="40" Height="40" FontSize="16" Click="Play_Click" ToolTip="Play or pause"/>
                                    <Button Style="{StaticResource IconBtn}" Content="&#xE893;" Background="Transparent"
                                            Click="Next_Click" ToolTip="Next"/>
                                </StackPanel>
                            </Grid>

                            <!-- Timer -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE916;" FontFamily="{StaticResource Icons}" FontSize="15"
                                               Foreground="#FFFF9F0A" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TimerBig" Text="Timer" FontSize="15" FontWeight="SemiBold"
                                               Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource TextBtn}" Content="5 min" Tag="5" Click="TimerStart_Click"/>
                                    <Button Style="{StaticResource TextBtn}" Content="15" Tag="15" Click="TimerStart_Click"/>
                                    <Button Style="{StaticResource TextBtn}" Content="25" Tag="25" Click="TimerStart_Click"/>
                                    <Button x:Name="TimerCancel" Style="{StaticResource TextBtn}" Content="Stop"
                                            Background="#66FF453A" Visibility="Collapsed" Click="TimerCancel_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Pet: pet it, feed it, play with it -->
                            <StackPanel x:Name="PetSection" Margin="0,4,0,0">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock x:Name="PetLine" FontSize="12.5" FontWeight="SemiBold" Foreground="White"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,170,0"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource TextBtn}" Content="Pet" Click="PetPet_Click"/>
                                        <Button Style="{StaticResource TextBtn}" Content="Feed" Click="PetFeed_Click"/>
                                        <Button Style="{StaticResource TextBtn}" Content="Play" Click="PetPlay_Click"/>
                                    </StackPanel>
                                </Grid>
                                <pets:PetPlayground x:Name="Playground"/>
                                <StackPanel x:Name="PetMeters" Orientation="Horizontal" Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- VOLUME -->
                        <StackPanel x:Name="AudioPanel" Visibility="Collapsed">
                            <TextBlock Text="Volume" FontSize="14" FontWeight="SemiBold" Foreground="White"
                                       Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Everything" FontSize="12.5" FontWeight="SemiBold" Foreground="White"
                                           VerticalAlignment="Center"/>
                                <Slider x:Name="MasterSlider" Grid.Column="1" Style="{StaticResource IslandSlider}"
                                        ValueChanged="MasterSlider_ValueChanged"/>
                                <TextBlock x:Name="MasterText" Grid.Column="2" FontSize="12" Foreground="#CCFFFFFF"
                                           TextAlignment="Right" VerticalAlignment="Center"/>
                                <Button x:Name="MasterMuteBtn" Grid.Column="3" Style="{StaticResource IconBtn}"
                                        Width="28" Height="28" FontSize="12" Margin="8,0,0,0" Content="&#xE767;"
                                        Click="MasterMute_Click" ToolTip="Mute or unmute all sound"/>
                            </Grid>
                            <TextBlock Text="Playing now" FontSize="11.5" Foreground="#80FFFFFF" Margin="0,0,0,6"/>
                            <StackPanel x:Name="AudioApps"/>
                            <TextBlock x:Name="AudioEmpty" FontSize="12" Foreground="#80FFFFFF" Margin="0,0,0,4"
                                       Text="No app is playing sound right now."/>
                        </StackPanel>

                        <!-- FILE SHELF -->
                        <StackPanel x:Name="ShelfPanel" Visibility="Collapsed">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="File shelf" FontSize="14" FontWeight="SemiBold" Foreground="White"
                                           VerticalAlignment="Center"/>
                                <Button Style="{StaticResource TextBtn}" Content="Clear" HorizontalAlignment="Right"
                                        Click="ShelfClear_Click"/>
                            </Grid>
                            <TextBlock x:Name="ShelfEmpty" FontSize="12" Foreground="#80FFFFFF" Margin="0,6,0,8"
                                       TextWrapping="Wrap"
                                       Text="Drag files onto the island to park them here, then drag them out wherever you need them."/>
                            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ShelfList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="88" Height="66" Margin="0,0,8,8" CornerRadius="12"
                                                    Background="#1FFFFFFF" Cursor="Hand"
                                                    Tag="{Binding}" ToolTip="{Binding FullPath}"
                                                    MouseLeftButtonDown="ShelfItem_Down"
                                                    MouseMove="ShelfItem_Move"
                                                    MouseLeftButtonUp="ShelfItem_Up">
                                                <Grid>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}"
                                                                   FontSize="20" Foreground="White"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="10.5" Foreground="#CCFFFFFF"
                                                                   Margin="6,5,6,0" HorizontalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Button Style="{StaticResource IconBtn}" Content="&#xE711;"
                                                            Width="18" Height="18" FontSize="7" Margin="3"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Tag="{Binding}" Click="ShelfRemove_Click"
                                                            ToolTip="Remove from shelf"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- CLIPBOARD HISTORY -->
                        <StackPanel x:Name="ClipPanel" Visibility="Collapsed">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Clipboard" FontSize="14" FontWeight="SemiBold" Foreground="White"
                                           VerticalAlignment="Center"/>
                                <Button Style="{StaticResource TextBtn}" Content="Clear" HorizontalAlignment="Right"
                                        Click="ClipClear_Click"/>
                            </Grid>
                            <TextBlock x:Name="ClipEmpty" FontSize="12" Foreground="#80FFFFFF" Margin="0,6,0,8"
                                       Text="Text you copy shows up here. Click an entry to copy it again."/>
                            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ClipList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowBtn}" Content="{Binding Preview}"
                                                    Tag="{Binding}" Click="ClipItem_Click"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- SYSTEM STATS -->
                        <StackPanel x:Name="StatsPanel" Visibility="Collapsed">
                            <TextBlock Text="System" FontSize="14" FontWeight="SemiBold" Foreground="White"
                                       Margin="0,0,0,8"/>
                            <StackPanel x:Name="StatsRows"/>
                            <TextBlock x:Name="NetText" FontSize="12" Foreground="#CCFFFFFF" Margin="0,8,0,0"/>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
